{
  "name": "budburry",
  "version": "1.0.0",
  "description": "Budburry's Playlist",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node sync-data.js",
    "build": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.1.0"
  },
  "build": {
    "appId": "com.budburry.playlist",
    "productName": "Budburry's",
    "directories": {
      "output": "../dist",
      "app": "."
    },
    "win": {
      "icon": "../icons/icon.ico",
      "target": [{ "target": "dir", "arch": ["x64"] }]
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      { "from": "../server.py", "to": "server.py" },
      { "from": "../emotes.json", "to": "../emotes.json" },
      { "from": "../song_tags.json", "to": "../song_tags.json" },
      { "from": "../song_ratings.json", "to": "../song_ratings.json" },
      { "from": "../index.html", "to": "../index.html" },
      { "from": "../mini-player.html", "to": "../mini-player.html" },
      { "from": "../app.js", "to": "../app.js" },
      { "from": "../styles.css", "to": "../styles.css" },
      { "from": "../logo_black.svg", "to": "../logo_black.svg" },
      { "from": "../logo_white.svg", "to": "../logo_white.svg" },
      { "from": "../manifest.webmanifest", "to": "../manifest.webmanifest" },
      { "from": "../icons", "to": "../icons" },
      { "from": "../mp3", "to": "../mp3" }
    ]
  }
}
